{
  "name": "personal-skills-tooling",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "type": "module",
  "description": "Development tooling for a personal agent skills repository",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mugiwaraluffy56/skills.git"
  },
  "homepage": "https://github.com/mugiwaraluffy56/skills#readme",
  "bugs": {
    "url": "https://github.com/mugiwaraluffy56/skills/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "changeset": "changeset",
    "version:skills": "changeset version && npm run sync:version && npm install --package-lock-only && npm run check",
    "release": "changeset tag",
    "list:skills": "bash scripts/list-skills.sh",
    "link:skills": "npm run validate && bash scripts/link-skills.sh",
    "sync:version": "node scripts/sync-plugin-version.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test && node scripts/run-atlas-tests.mjs",
    "check": "npm run validate && npm test"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "yaml": "^2.8.1"
  }
}
